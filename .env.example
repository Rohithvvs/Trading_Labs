# Copy to .env and fill in locally. Never commit real credentials.
# Define each variable once. Duplicate DATABASE_URL lines are last-wins and easy to mis-point.

# ---------------------------------------------------------------------------
# Operational application database (required)
# Local Postgres in development, or Nova/Neon in deployment.
# The running app uses this URL only. Do not point it at Turso.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# ---------------------------------------------------------------------------
# One-time local Postgres source for Turso history copy (optional)
# Must be local trading_data. Never used by normal app runtime.
# Live migration refuses if this is unset (it will not fall back to DATABASE_URL).
# ---------------------------------------------------------------------------
LOCAL_POSTGRES_DATABASE_URL=

# ---------------------------------------------------------------------------
# Turso / libSQL — v1 daily_ohlcv + index_ohlcv only
# Unused while CANDLE_HISTORY_BACKEND=postgres.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://YOUR-DB.turso.io
TURSO_AUTH_TOKEN=

# postgres (default) until you explicitly switch after a successful live validation
CANDLE_HISTORY_BACKEND=postgres

# ---------------------------------------------------------------------------
# Read-only repair preview only (process environment). Never commit real values.
# Preview does NOT read these from DATABASE_URL / token tables.
# Prefer session env vars over putting tokens in .env:
#   $env:FYERS_APP_ID = "..."
#   $env:FYERS_ACCESS_TOKEN = "..."
# ---------------------------------------------------------------------------
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=
