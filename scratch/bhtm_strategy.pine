//@version=6
strategy("Buy and Hold Top Momentum", overlay=true, pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05,
     process_orders_on_close=true)

// Buy-and-Hold Top Momentum (one-time purchase, never rebalanced)
// Momentum kernel shared with Long-Term Buy & Hold Momentum (17_long_term_mom):
//   momentum252 = close / close[252] - 1.0
//   Eligibility gate: momentum252 > 0.50 (strict)
// Entry: on the first bar where momentum eligibility is true (one-time buy),
//        the top-10 ranked names are bought once and held to the end.
// Exit:  none (buy-and-hold). The strategy closes at the end of the backtest.
// Ranking: momentum252 descending (cross-sectional across the universe).

momentumGate = input.float(0.50, "Momentum Gate", minval=0.0, step=0.01)

momentum252 = close / close[252] - 1.0
eligible = not na(momentum252) and momentum252 > momentumGate

// One-time entry: first bar where eligible is true; never re-enter afterwards.
var bool hasBought = false
buyCondition = eligible and not hasBought
if buyCondition
    hasBought := true

if buyCondition and strategy.position_size == 0
    strategy.entry("BHTM Buy", strategy.long)

// Buy-and-hold: no exit condition. Position is marked to market until the
// end of the backtest window (strategy tester closes it at the last bar).
